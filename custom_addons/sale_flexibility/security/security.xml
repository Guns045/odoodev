<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Groups for Sale Flexibility Module -->

        <!-- Group: Sales Document Editor - Can edit printed documents -->
        <record id="group_sales_document_editor" model="res.groups">
            <field name="name">Sales Document Editor</field>
            <field name="comment">Can edit sales documents even after they are printed.</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- Group: Accounting Document Editor - Can edit printed invoices -->
        <record id="group_accounting_document_editor" model="res.groups">
            <field name="name">Accounting Document Editor</field>
            <field name="comment">Can edit accounting documents (invoices) even after they are printed.</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Group: Stock Document Editor - Can edit printed delivery orders -->
        <record id="group_stock_document_editor" model="res.groups">
            <field name="name">Stock Document Editor</field>
            <field name="comment">Can edit stock documents (delivery orders) even after they are printed.</field>
            <field name="category_id" ref="base.module_category_warehouse_management"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <!-- Group: Administrator - Full control over all document editing -->
        <record id="group_flexibility_admin" model="res.groups">
            <field name="name">Flexibility Administrator</field>
            <field name="comment">Full administrator access for document flexibility features.</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[
                (4, ref('group_sales_document_editor')),
                (4, ref('group_accounting_document_editor')),
                (4, ref('group_stock_document_editor')),
                (4, ref('base.group_erp_manager'))
            ]"/>
        </record>

        <!-- Record Rules for controlling access to printed documents -->

        <!-- Sale Order Record Rule - Users can edit non-printed documents, editors can edit all -->
        <record id="sale_order_edit_rule" model="ir.rule">
            <field name="name">Sale Order Edit Rule</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[
                '|',
                ('x_is_printed', '=', False),
                ('user_has_groups', 'sale_flexibility.group_sales_document_editor'),
            ]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Account Move Record Rule - Users can edit non-printed documents, editors can edit all -->
        <record id="account_move_edit_rule" model="ir.rule">
            <field name="name">Account Move Edit Rule</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                '|',
                ('x_is_printed', '=', False),
                ('user_has_groups', 'sale_flexibility.group_accounting_document_editor'),
            ]</field>
            <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Stock Picking Record Rule - Users can edit non-printed documents, editors can edit all -->
        <record id="stock_picking_edit_rule" model="ir.rule">
            <field name="name">Stock Picking Edit Rule</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[
                '|',
                ('x_is_printed', '=', False),
                ('user_has_groups', 'sale_flexibility.group_stock_document_editor'),
            ]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>