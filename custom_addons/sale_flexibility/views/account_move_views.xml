<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Account Move Form View Inheritance -->
        <record id="view_move_form_inherit_flexibility" model="ir.ui.view">
            <field name="name">account.move.form.inherit.flexibility</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Add x_is_printed field to the form (make it invisible in normal view) -->
                <field name="state" position="after">
                    <field name="x_is_printed" invisible="1"/>
                </field>

                <!-- Make invoice_date editable if not printed -->
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make partner_id editable if not printed -->
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make journal_id editable if not printed -->
                <xpath expr="//field[@name='journal_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make currency_id editable if not printed -->
                <xpath expr="//field[@name='currency_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make payment_reference editable if not printed -->
                <xpath expr="//field[@name='payment_reference']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make invoice_payment_term_id editable if not printed -->
                <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make invoice_date_due editable if not printed -->
                <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make move line fields editable if not printed -->
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.x_is_printed', '=', True)]}</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.x_is_printed', '=', True)]}</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.x_is_printed', '=', True)]}</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.x_is_printed', '=', True)]}</attribute>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.x_is_printed', '=', True)]}</attribute>
                </xpath>

                <!-- Make narration field editable if not printed -->
                <xpath expr="//field[@name='narration']" position="attributes">
                    <attribute name="attrs">{'readonly': [('x_is_printed', '=', True)]}</attribute>
                </xpath>

            </field>
        </record>

        <!-- Account Move Tree View Inheritance - Add printed status indicator -->
        <record id="view_move_tree_inherit_flexibility" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.flexibility</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="state" position="before">
                    <field name="x_is_printed" widget="boolean_toggle" optional="show"/>
                </field>
            </field>
        </record>

        <!-- Add Kanban view printed status indicator -->
        <record id="view_move_kanban_inherit_flexibility" model="ir.ui.view">
            <field name="name">account.move.kanban.inherit.flexibility</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_move_kanban"/>
            <field name="arch" type="xml">
                <field name="state" position="after">
                    <field name="x_is_printed"/>
                </field>
                <xpath expr="//div[hasclass('oe_kanban_content')]" position="inside">
                    <div t-if="record.x_is_printed.raw_value" class="text-warning">
                        <i class="fa fa-print"/> Printed
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>